# ============================================================
# BACKEND ENVIRONMENT VARIABLES — copy to .env and fill in
# ============================================================

# Server
PORT=5000
NODE_ENV=production

# Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-string
JWT_EXPIRES_IN=7d

# Email / SMTP (for forgot-password emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=noreply@icgc.in

# Frontend URL (for CORS — set to Vercel URL in production)
FRONTEND_URL=https://your-app.vercel.app

# Puppeteer (leave blank for local dev; set on Render)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
